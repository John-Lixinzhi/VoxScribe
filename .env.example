# VoxScribe 环境变量示例
# 用法：复制为 .env 后按实际环境填写；真实密钥不要提交到仓库。

# ---------- 桌面端（可选，Ollama 润色）----------
VOXSCRIBE_OLLAMA_HOST=http://127.0.0.1:11434
VOXSCRIBE_OLLAMA_MODEL=qwen2.5:7b

# ---------- CloudBase 云函数 ----------
# 云函数访问的独立 ASR 服务地址，必须是 HTTPS
ASR_SERVICE_URL=https://your-asr-host.example.com

# ---------- ASR 服务 server/app.py ----------
# Bearer 令牌：server 用它校验请求，云函数用同一个值调用
# 留空表示不校验，仅限本机调试；线上必须设置
ASR_SERVICE_TOKEN=

# 单文件大小上限（字节），默认 200 MB
MAX_FILE_BYTES=209715200
# Whisper 模型缓存目录
MODELS_DIR=./models
# 推理设备：auto | cuda | cpu
WHISPER_DEVICE=auto
# 计算精度：auto | float16 | int8_float16 | int8
WHISPER_COMPUTE_TYPE=auto

# ---------- 微信支付 ----------
# 微信支付商户号，仅 createOrder 云函数使用
WECHAT_PAY_MCHID=
